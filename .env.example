# DecisionAI Configuration
# Set your Gemini API key here. If left blank, DecisionAI will automatically
# operate in high-fidelity Demo / Simulation Fallback Mode (ideal for offline presentations).
# Set your OpenAI API key (starts with sk-proj-... or sk-...) or Gemini API key here.
# If left blank, DecisionAI operates in built-in High-Fidelity Simulation Fallback Mode.
OPENAI_API_KEY=
GEMINI_API_KEY=
PORT=5000
SECRET_KEY=decision-ai-secret-key-2026
